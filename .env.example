# AI DocMaster — Configuration Template
# Copy this file to '.env' and edit as required.

# ── Flask & Security Configuration ────────────────────────────────────
# Opt-in debug mode ('1' for local dev, '0' or comment out for production)
FLASK_DEBUG=0
FLASK_ENV=production

# Security Keys (change these to strong unique random strings in production!)
FLASK_SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_SECRET_IN_RENDER_DASHBOARD
JWT_SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_SECRET_IN_RENDER_DASHBOARD

# Allowed CORS Origins (comma-separated origins. Leave empty to fallback to default local ports)
ALLOWED_CORS_ORIGINS=https://YOUR_RENDER_FRONTEND_URL.onrender.com,http://localhost:5500

# OAuth Redirect URIs (Required for production Auth)
GOOGLE_REDIRECT_URI=https://YOUR_RENDER_BACKEND_URL.onrender.com/auth/google/callback
GITHUB_REDIRECT_URI=https://YOUR_RENDER_BACKEND_URL.onrender.com/auth/github/callback

# Admin Email address (used to grant access to the /feedback dashboard panel)
ADMIN_EMAIL=admin@aidocmaster.com

# ── Database Configuration ────────────────────────────────────────────
# TiDB Cloud Connection
TIDB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=4J6whjqykgwWcYk.root
TIDB_PASSWORD=qG9XE8uTX08WdT7E
TIDB_DB_NAME=ai_docmaster

# Cloudflare R2 Connection
R2_ACCOUNT_ID=YOUR_R2_ACCOUNT_ID
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
R2_BUCKET_NAME=YOUR_R2_BUCKET_NAME

# ── AI Services & Engines ──────────────────────────────────────────────
# Grok API Key
GROK_API_KEY=YOUR_GROK_API_KEY_HERE
# ── OCR & System Binaries ─────────────────────────────────────────────
# Path to local Tesseract executable
TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe

# Optional path to local Poppler binaries (if not in PATH)
# POPPLER_PATH=C:\poppler\bin
ALLOWED_CORS_ORIGINS=https://your-production-frontend.com
