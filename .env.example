# AI DocMaster — Configuration Template
# Copy this file to '.env' and edit as required.

# ── Flask & Security Configuration ────────────────────────────────────
# Opt-in debug mode ('1' for local dev, '0' or comment out for production)
FLASK_DEBUG=0
FLASK_ENV=production

# Security Keys (change these to strong unique random strings in production!)
FLASK_SECRET_KEY=your-super-secret-random-production-key-here
JWT_SECRET_KEY=your-super-jwt-secret-random-production-key-here

# Allowed CORS Origins (comma-separated origins. Leave empty to fallback to default local ports)
ALLOWED_CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Admin Email address (used to grant access to the /feedback dashboard panel)
ADMIN_EMAIL=admin@aidocmaster.com

# ── Database Configuration ────────────────────────────────────────────
# Local MongoDB connection URI
MONGO_URI=mongodb://localhost:27017/
# Remote / Hosted connection URI (e.g. MongoDB Atlas)
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

MONGO_DB_NAME=ai_docmaster

# ── AI Services & Engines ──────────────────────────────────────────────
# Google Gemini API Key
GEMINI_API_KEY=your-gemini-api-key-here

# ── OCR & System Binaries ─────────────────────────────────────────────
# Path to local Tesseract executable
TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe

# Optional path to local Poppler binaries (if not in PATH)
# POPPLER_PATH=C:\poppler\bin
